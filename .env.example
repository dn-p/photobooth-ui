# Cloudinary Configuration for Photobooth
# Dapatkan Cloud Name di dashboard Cloudinary (https://cloudinary.com/console)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# Buat Unsigned Upload Preset di Settings > Upload > Add upload preset > Signing Mode: Unsigned
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_here
